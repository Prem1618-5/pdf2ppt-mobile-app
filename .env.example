# Copy this file to .env and fill in the values.
# .env holds your private keys and is never committed.
# .env.example is the shared template that shows which variables the app needs.

# Paste your Gemini API key into the .env file as the value of GEMINI_API_KEY.
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
